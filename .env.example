NODE_ENV=production
KARAOKE_PORT=8000
# Permite que qualquer participante peça para pular a música em reprodução.
KARAOKE_ALLOW_SKIP=true
# Pontuação máxima do ranking por música; o resultado é normalizado para este teto.
KARAOKE_SCORE_MAX=1000
# Duração máxima, em milissegundos, de cada bloco de legenda usado para pontuar.
KARAOKE_SCORE_BLOCK_MS=3000
# Número de linhas/faixas usadas para alternar os blocos na TV.
KARAOKE_SCORE_LANES=3
# Janela de histórico para descartar frases repetidas na legenda (milissegundos).
KARAOKE_CAPTION_HISTORY_MS=60000
# Descartar frase se uma sequência já exibida cobrir mais que esta porcentagem.
KARAOKE_CAPTION_REPEAT_PERCENT=70
# Margem, em milissegundos, antes/depois do início do bloco para aceitar o canto.
KARAOKE_SCORE_TOLERANCE_MS=100
# Pontos descontados ao detectar som fora de um bloco de legenda.
KARAOKE_SCORE_OFF_CUE_PENALTY=1
# Intervalo mínimo, em milissegundos, entre penalidades por som fora da legenda.
KARAOKE_SCORE_OFF_CUE_REARM_MS=500
# Nível RMS mínimo do microfone para considerar que houve som (entre 0 e 1).
KARAOKE_SCORE_RMS_THRESHOLD=0.04
# Set the Wi-Fi IPv4 address to include it in the TV's join QR.
KARAOKE_LAN_IP=
